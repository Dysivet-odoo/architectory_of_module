        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml classes_us_messenger\nset namespaceSeparator none\nclass \&quot;Attachment\&quot; as us_messenger.models.ir_attachment.Attachment {\n}\nclass \&quot;AttrDict\&quot; as us_messenger.models.us_messenger_project.AttrDict {\n}\nclass \&quot;Base\&quot; as us_messenger.models.base.Base {\n  search_links(relation_name, bot_id, refs)\n  set_link(relation_name, ref, bot_id, sync_date, allow_many2many)\n}\nclass \&quot;DiscussController\&quot; as us_messenger.controllers.mail.DiscussController {\n  get_model_name_of_model(model)\n}\nclass \&quot;IrActionsServer\&quot; as us_messenger.models.ir_actions.IrActionsServer {\n  messenger_task_id\n  project_id\n}\nclass \&quot;IrLogging\&quot; as us_messenger.models.ir_logging.IrLogging {\n  message_short\n  messenger_job_id\n  messenger_task_id\n  project_id\n  type\n}\nclass \&quot;LogExternalQuery\&quot; as us_messenger.tools.LogExternalQuery {\n  log\n  log_transmission\n  target_name\n}\nclass \&quot;MailMessage\&quot; as us_messenger.models.mail_message.MailMessage {\n  document_message_id\n  external_messenger_id\n  get_my_messages_action()\n}\nclass \&quot;MailThread\&quot; as us_messenger.models.mail_thread.MailThread {\n  message_post()\n}\nclass \&quot;ResConfigSettings\&quot; as us_messenger.models.res_config_settings.ResConfigSettings {\n  auto_operator_selection\n  group_auto_operator_selection\n  is_add_new_operators_to_channel\n  set_values()\n}\nclass \&quot;ResPartner\&quot; as us_messenger.models.res_partner.ResPartner {\n  type_messenger\n  action_archive()\n  action_change_parent_messenger()\n  action_unarchive()\n}\nclass \&quot;ServerAction\&quot; as us_messenger.lib.models.ir_actions.ServerAction {\n  webhook_type\n  website_path\n  website_url\n  action_website_path()\n}\nclass \&quot;UsMessengerDiscussOperatorWizard\&quot; as us_messenger.wizard.us_messenger_discuss_operator_wizard.UsMessengerDiscussOperatorWizard {\n  channel_id\